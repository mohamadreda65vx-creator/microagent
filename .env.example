# ───────────────────────────────────────────────────────────────
# MicroAgent environment. Copy to .env and fill in real values.
# NEVER commit .env.
# ───────────────────────────────────────────────────────────────

NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# Public URL of the app (used for CSRF Origin checks and links inside emails).
# Dev: the Vite dev server. Production: https://your-domain.com
APP_URL=http://localhost:5173

# Three database roles (created by infra/db/setup.sh). Different privileges on purpose:
#  OWNER    -> only for migrations (owns the tables)
#  APP      -> every tenant request. Row Level Security is enforced for this role.
#  PLATFORM -> only the Platform Admin module (explicit cross-tenant policies)
DATABASE_URL_OWNER=postgres://microagent_owner:CHANGE_ME@localhost:5432/microagent_dev
DATABASE_URL_APP=postgres://microagent_app:CHANGE_ME@localhost:5432/microagent_dev
DATABASE_URL_PLATFORM=postgres://microagent_platform:CHANGE_ME@localhost:5432/microagent_dev

# Database used by the automated tests (same roles, separate database).
TEST_DATABASE_NAME=microagent_test

# Session lifetime in days
SESSION_TTL_DAYS=14

# Email (password reset + invitations).
# If SMTP_HOST is empty, emails are NOT sent: they are written to the email_outbox
# table and logged to the console (development only). Set SMTP_* before going live.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MicroAgent <no-reply@your-domain.com>"
