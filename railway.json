{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "RAILPACK", "buildCommand": "npm ci --include=dev && npm run build" },
  "deploy": {
    "startCommand": "node infra/db/bootstrap.mjs && npm run db:migrate:prod && npm start",
    "healthcheckPath": "/api/v1/health",
    "healthcheckTimeout": 120,
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
