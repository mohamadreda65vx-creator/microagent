# MicroAgent — PRODUCTION environment template. Copy to /opt/microagent/.env on the server, fill every value, then `chmod 600 .env`.
# Never commit the real file. Never put it in a ZIP. See ENVIRONMENT_VARIABLES.md for every variable.
NODE_ENV=production
HOST=127.0.0.1
PORT=4000
APP_URL=https://app.example.com
TRUST_PROXY=true

DATABASE_URL_OWNER=postgres://microagent_owner:GENERATE_ME@localhost:5432/microagent_prod
DATABASE_URL_APP=postgres://microagent_app:GENERATE_ME@localhost:5432/microagent_prod
DATABASE_URL_PLATFORM=postgres://microagent_platform:GENERATE_ME@localhost:5432/microagent_prod

SESSION_TTL_DAYS=14
CHANNEL_SECRET_KEY=GENERATE_WITH_openssl_rand_-base64_32

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MicroAgent <no-reply@example.com>"

OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
OPENROUTER_MODELS=
AI_MONTHLY_TOKEN_LIMIT=2000000

EVOLUTION_API_URL=
EVOLUTION_API_KEY=
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
